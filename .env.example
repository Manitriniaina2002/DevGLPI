# ══════════════════════════════════════════════════════════════════
#  Dashboard Achat GLPI — Configuration globale
#  Copier en .env et adapter à votre environnement
# ══════════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────────
USE_MOCK_DATA=false
DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard_achat

# ── GLPI API ──────────────────────────────────────────────────────
GLPI_BASE_URL=http://nginx
GLPI_APP_TOKEN=3eb0995b74d348d50ac331233bc89a6dcd7aee58
GLPI_USER_TOKEN=hMxia50t0QFI96BjFP38mc6md1aEbuE6gERjVWty
GLPI_PURCHASE_CATEGORY_ID=0

# ── CORS ──────────────────────────────────────────────────────────
# Inclure l'URL publique du frontend en prod
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# ── Frontend ──────────────────────────────────────────────────────
# URL du backend accessible depuis le NAVIGATEUR (pas depuis Docker)
# En local : http://localhost:9000
# En prod  : https://api.votre-domaine.com
NEXT_PUBLIC_API_URL=http://localhost:9000
