# ══════════════════════════════════════════════════════════════════
#  Dashboard Achat GLPI — Backend Configuration
#  docker-compose.yml variables (dashbord-achat repo)
# ══════════════════════════════════════════════════════════════════

# ── Mode de données ───────────────────────────────────────────────
# true  → données simulées (dev sans GLPI, défaut Docker)
# false → API GLPI réelle
USE_MOCK_DATA=true

# ── Base de données PostgreSQL ────────────────────────────────────
# En Docker : postgres = nom du service dans docker-compose.yml
DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard_achat

# ── GLPI API ──────────────────────────────────────────────────────
# Inter-stacks (merge docker-compose) : http://nginx
#   docker compose -f docker-compose.yml -f docker-compose.glpi.local.yml up -d
# Hôte direct (GLPI déjà démarré) : http://localhost:1080
# Distant (prod) : http://IP_SERVEUR:1080
GLPI_BASE_URL=http://nginx

# App-Token GLPI (généré via regen_token.php)
# php regen_token.php → copier la valeur NEW_APP_TOKEN=...
GLPI_APP_TOKEN=

# User-Token personnel GLPI
# GLPI → Profil utilisateur → API → Régénérer token
GLPI_USER_TOKEN=

# ── Catégorie tickets achat ───────────────────────────────────────
# ID de la catégorie GLPI « Demande d'achat » (0 = détection par mots-clés)
GLPI_PURCHASE_CATEGORY_ID=0

# ── CORS ──────────────────────────────────────────────────────────
# URLs autorisées pour le frontend React
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
