# ══════════════════════════════════════════════════════════════════
#  Dashboard Achat GLPI — Backend Configuration
#  docker-compose.yml variables (dashbord-achat repo)
# ══════════════════════════════════════════════════════════════════

# ── Mode de données ───────────────────────────────────────────────
# true  → données simulées (dev sans GLPI, défaut Docker)
# false → API GLPI réelle
USE_MOCK_DATA=true

# ── Base de données PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard_achat

# ── GLPI API ──────────────────────────────────────────────────────
GLPI_BASE_URL=http://nginx
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_PURCHASE_CATEGORY_ID=0

# ── Redis Cache ───────────────────────────────────────────────────
# En Docker : redis = nom du service dans docker-compose.yml
# Laisser vide pour désactiver Redis (fallback cache mémoire)
REDIS_URL=redis://redis:6379

# TTL en secondes (optionnel — valeurs par défaut ci-dessous)
REDIS_TTL_TICKET_HISTORY=300     # 5 min  — logs d'un ticket
REDIS_TTL_PURCHASE_TICKETS=120   # 2 min  — liste complète des tickets
REDIS_TTL_ASSIGNEES_MAP=120      # 2 min  — map acheteurs assignés
REDIS_TTL_USERS=1800             # 30 min — annuaire utilisateurs GLPI
REDIS_TTL_PROJECTS=1800          # 30 min — liste des projets
REDIS_TTL_VALIDATIONS=300        # 5 min  — validations d'un ticket

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── JWT ───────────────────────────────────────────────────────────
# Générer en prod : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-a-long-random-secret
GLPI_PLUGIN_SECRET=
