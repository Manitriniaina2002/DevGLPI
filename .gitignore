# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Local environment files
.env
.env.*
!.env.example
!.env.test.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.test.example

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Socket files
*.sock

# Logs
*.log
# GLPI
storage/glpi/files/_sessions/
storage/glpi/files/_cache/
storage/glpi/log/
storage/glpi/dump/
storage/glpi/tmp/

# MySQL data (deja present mais on complete)
storage/mysql/
storage/mysql-backup/

# -----------------------------
# Deployment / local ignores
# -----------------------------
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.mypy_cache/
coverage.xml
.coverage

# Logs and temp
*.log
*.tmp
*.bak
*.swp

# Node / frontend
node_modules/
frontend/.next/
frontend/.vercel/
dist/
build/

# Docker
docker-compose.override.yml
docker-compose.*.local.yml
*.env.local

# Local debug / generated files (not needed for deployment)
glpi_ticket_*_*.json
backend_tickets*.json
debug_*.json
api_output.json
raw_ticket_*.json

# Storage (local dumps, caches, DB files)
/storage/**

# Backups and DB dumps
*.sql
*.sqlite3
*.db

# Certificates / keys
*.pem
*.key
oauth.pub

# OS files
.DS_Store
Thumbs.db

# End
